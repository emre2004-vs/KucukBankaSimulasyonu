<Window x:Class="KucukBankaSimulasyonu.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Banka Paneli"
        Height="650"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 🔹 SOL MENÜ -->
        <Border Grid.Column="0"
                Background="#111827"
                Padding="20">

            <StackPanel>
                <TextBlock Text="🏦 Banka"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,30"/>

                <Button Content="🏠 Ana Sayfa"
                        Style="{StaticResource MenuButton}"
                        Click="AnaSayfa_Click"/>

                <Button Content="📄 İşlemler"
                        Style="{StaticResource MenuButton}"
                        Click="Islemler_Click"/>

                <Button Content="👤 Müşteri Bilgileri"
                        Style="{StaticResource MenuButton}"
                        Click="MusteriBilgileri_Click"/>

                <Button Content="⚙ Ayarlar"
                        Style="{StaticResource MenuButton}"/>
            </StackPanel>
        </Border>

        <!-- 🔹 SAĞ ALAN -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ÜST BAR -->
            <DockPanel Margin="0,0,0,20">
                <TextBlock x:Name="TxtAdSoyad"
                           FontSize="22"
                           FontWeight="SemiBold"
                           DockPanel.Dock="Left"/>

                <Ellipse Width="40"
                         Height="40"
                         Fill="#3B82F6"
                         DockPanel.Dock="Right"/>
            </DockPanel>

            <!-- 🔴 SAYFA ALANI -->
            <Frame x:Name="MainContent"
                   Grid.Row="1"
                   NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>
