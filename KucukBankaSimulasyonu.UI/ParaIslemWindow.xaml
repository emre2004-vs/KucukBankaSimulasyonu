<Window x:Class="KucukBankaSimulasyonu.UI.ParaIslemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Para İşlemi"
        Height="280"
        Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F9FAFB">

    <Border Padding="25" CornerRadius="12" Background="White">
        <StackPanel>

            <TextBlock x:Name="TxtBaslik"
                       Text="Para İşlemi"
                       FontSize="22"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Miktar"
                       FontSize="14"
                       Margin="0,0,0,5"/>

            <TextBox x:Name="TxtMiktar"
                     Height="40"
                     FontSize="16"
                     Padding="10"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,30,0,0">

                <Button Content="İptal"
                        Width="100"
                        Margin="0,0,10,0"
                        Click="Iptal_Click"/>

                <Button x:Name="BtnOnay"
                        Content="Onayla"
                        Width="120"
                        Background="#3B82F6"
                        Foreground="White"
                        Click="Onay_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
