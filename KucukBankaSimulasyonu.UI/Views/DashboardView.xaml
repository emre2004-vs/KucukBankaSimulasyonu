<UserControl x:Class="KucukBankaSimulasyonu.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F4F6">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 🔹 BAKİYE KARTI -->
        <Border Background="#3B82F6"
                CornerRadius="16"
                Padding="25"
                Margin="0,0,0,20">

            <StackPanel>
                <TextBlock Text="Toplam Bakiye"
                           Foreground="#E0E7FF"
                           FontSize="14"/>

                <TextBlock x:Name="TxtBakiye"
                           Text="₺ 0,00"
                           Foreground="White"
                           FontSize="36"
                           FontWeight="Bold"
                           Margin="0,10,0,15"/>

                <!-- 🔹 AKSİYON BUTONLARI -->
                <StackPanel Orientation="Horizontal">
                    <Button Content="➕ Para Yatır"
                            Style="{StaticResource ActionButtonGreen}"
                            Click="ParaYatir_Click"/>

                    <Button Content="➖ Para Çek"
                            Style="{StaticResource ActionButtonBlue}"
                            Margin="10,0,0,0"
                            Click="ParaCek_Click"/>

                    <Button Content="🔁 Transfer"
                            Style="{StaticResource ActionButtonTeal}"
                            Margin="10,0,0,0"
                            Click="TransferToggle_Click"/>
                </StackPanel>

                <!-- 🔁 TRANSFER PANELİ -->
                <Border x:Name="TransferPanel"
        Background="#ECFEFF"
        CornerRadius="12"
        Padding="15"
        Margin="0,15,0,0"
        Visibility="Collapsed">

                    <StackPanel>
                        <TextBlock Text="🔁 Hesaplar Arası Transfer"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10"/>

                        <!-- 🔹 HEDEF HESAP -->
                        <Grid Margin="0,0,0,10">
                            <TextBox x:Name="TxtHedefHesap"
                     Height="35"
                     VerticalContentAlignment="Center"/>

                            <TextBlock Text="Hedef Hesap No"
                       Foreground="Gray"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TxtHedefHesap}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- 🔹 TRANSFER TUTARI -->
                        <Grid Margin="0,0,0,10">
                            <TextBox x:Name="TxtTransferTutar"
                     Height="35"
                     VerticalContentAlignment="Center"/>

                            <TextBlock Text="Transfer Tutarı"
                       Foreground="Gray"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TxtTransferTutar}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Button Content="Transfer Yap"
                Height="38"
                Background="#14B8A6"
                Foreground="White"
                BorderThickness="0"
                Click="TransferYap_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- 🔹 SON İŞLEMLER -->
        <Border Grid.Row="1" Style="{StaticResource InfoCard}">
            <StackPanel>
                <TextBlock Text="📄 Son İşlemler"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <ListView x:Name="LvIslemler" Height="250">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Tarih"
                                            Width="150"
                                            DisplayMemberBinding="{Binding IslemTarihi,
                                            StringFormat={}{0:dd.MM.yyyy HH:mm}}"/>

                            <GridViewColumn Header="İşlem"
                                            Width="140"
                                            DisplayMemberBinding="{Binding IslemTipi}"/>

                            <GridViewColumn Header="Tutar"
                                            Width="120"
                                            DisplayMemberBinding="{Binding Miktar,
                                            StringFormat=₺ {0:N2}}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
