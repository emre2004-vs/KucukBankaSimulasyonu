<Window x:Class="KucukBankaSimulasyonu.UI.Views.IslemlerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="İşlem Geçmişi"
        Height="500"
        Width="450"
        WindowStartupLocation="CenterOwner"
        Background="#F3F4F6">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="📄 İşlem Geçmişi"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20"
                   Foreground="#111827"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Islemler}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White"
                                CornerRadius="12"
                                Margin="0,0,0,10"
                                Padding="15">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{Binding IslemTipi}"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Foreground="#111827"/>

                                    <TextBlock Text="{Binding IslemTarihi,
                                              StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                               FontSize="12"
                                               Foreground="Gray"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Miktar,
                                           StringFormat=₺ {0:N2}}"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Foreground="#3B82F6"/>
                            </Grid>

                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
